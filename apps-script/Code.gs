function handleInquiry(e){const body=parsePost_(e); if(body.website||Number(body.formStartedAt)&&Date.now()-Number(body.formStartedAt)<2500)throw new Error('spam'); const allowed=['name','company','role','email','phone','country','product','categoryId','categoryName','gateId','documentId','claimId','currentUrl','requestType','targetDate','expectedVolume','budgetRange','meetingPreference','ndaRequested','message','consent','marketingConsent']; const clean={}; allowed.forEach(k=>clean[k]=safe_(body[k],k==='message'?3000:300)); if(!clean.name||!clean.company||!clean.email||clean.consent!=='true'||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(clean.email))throw new Error('required'); const normalizedEmail=clean.email.toLowerCase(); const cacheKey='inquiry_'+Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.MD5,normalizedEmail)).slice(0,80); const cache=CacheService.getScriptCache(); if(cache.get(cacheKey))throw new Error('duplicate'); cache.put(cacheKey,'1',3600); const id='REQ-'+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),'yyyyMMdd-HHmmss')+'-'+Utilities.getUuid().slice(0,6).toUpperCase(); const route=route_(clean.categoryId); const categoryName=clean.categoryName||clean.categoryId||'협업'; const summary=clean.company+'의 '+(clean.role||'담당자')+'가 '+categoryName+' 상담을 요청했습니다. '+(clean.gateId?clean.gateId+' Gate 문맥이 연결되었습니다.':''); const sheet=SpreadsheetApp.openById(prop_('MASTER_SHEET_ID')).getSheetByName(SHEETS.inquiries); sheet.appendRow([id,new Date(),'NEW',clean.categoryId||'',categoryName,clean.name,clean.company,clean.role||'',normalizedEmail,clean.phone||'',clean.country||'',clean.product||'',clean.gateId||'',clean.documentId||'',clean.claimId||'',clean.currentUrl||'',clean.requestType||'',clean.targetDate||'',clean.expectedVolume||'',clean.budgetRange||'',clean.meetingPreference||'',clean.ndaRequested||'',clean.message||'',summary,clean.consent,clean.marketingConsent||'N','web',route.owner,new Date(Date.now()+(route.sla||48)*3600000),'','']); sendInquiryNotifications({id,clean,route,summary}); writeAuditLog('inquiry',id); return {ok:true,requestId:id};}
function doPost(e){try{return ContentService.createTextOutput(JSON.stringify(handleInquiry(e))).setMimeType(ContentService.MimeType.JSON);}catch(err){writeAuditLog('inquiry-error',String(err.message||'unknown')); return ContentService.createTextOutput(JSON.stringify({ok:false,error:'문의 처리에 실패했습니다. 입력값과 중복 제출 여부를 확인해 주세요.'})).setMimeType(ContentService.MimeType.JSON);}}
