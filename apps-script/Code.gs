function scanDriveAndUpsertDocuments(){const root=DriveApp.getFolderById(prop_('ROOT_FOLDER_ID')); const ss=SpreadsheetApp.openById(prop_('MASTER_SHEET_ID')); const sheet=ss.getSheetByName(SHEETS.documents); const values=sheet.getDataRange().getValues(); const ids={}; values.slice(1).forEach((r,i)=>{if(r[1]) ids[String(r[1])]=i+2;}); const seen={}; const walk=(folder,folderPath)=>{const files=folder.getFiles(); while(files.hasNext()){const f=files.next(); const id=f.getId(); seen[id]=true; const row=ids[id]||sheet.getLastRow()+1; const old=ids[id]?sheet.getRange(row,1,1,18).getValues()[0]:[]; const docId=old[0]||'DOC-'+id.slice(0,8).toUpperCase(); const v=[docId,id,old[2]||folderPath,old[3]||'미분류',old[4]||f.getName(),f.getName(),old[6]||'',old[7]||'',old[8]||'RESTRICTED',old[9]||'N',old[10]||'원본등록',old[11]||1,old[12]||'',old[13]||'자동등록 문서',f.getLastUpdated(),old[15]||f.getUrl(),old[16]||'미검토',old[17]||'']; sheet.getRange(row,1,1,18).setValues([v]);} const folders=folder.getFolders(); while(folders.hasNext()){const child=folders.next(); walk(child,folderPath+'/'+child.getName());}}; walk(root,root.getName()); for(let i=2;i<=sheet.getLastRow();i++){const id=String(sheet.getRange(i,2).getValue()||''); if(id&&!seen[id]&&sheet.getRange(i,11).getValue()!=='ARCHIVED') sheet.getRange(i,11).setValue('MISSING');} writeSyncLog('scanDriveAndUpsertDocuments','success',''); writeAuditLog('drive-scan',Object.keys(seen).length+' files');}
