function mapStatus_(value){const v=String(value||'').replace(/\s/g,''); if(v==='완료')return 'complete'; if(v==='진행중')return 'in_progress'; if(v==='차단'||v==='보류')return 'blocked'; return 'not_started';}
function dashboardMetric_(ss,label){const sheet=ss.getSheetByName(SHEETS.project); if(!sheet)return ''; const rows=sheet.getDataRange().getValues(); for(const row of rows){for(let i=0;i<row.length;i++){if(String(row[i]||'').trim()===label)return row[i+1]||'';}} return '';}
function settingValue_(ss,key){const sheet=ss.getSheetByName(SHEETS.settings); if(!sheet)return ''; const rows=sheet.getDataRange().getValues(); for(const row of rows.slice(1)){const k=String(row[0]||'').trim(); if(k===key)return row[1]||'';} return '';}
